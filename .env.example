# ==============================================================================
# Enterprise Multi-Agent AI Assistant - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY APPLICATION DATABASE: MONGODB
# ------------------------------------------------------------------------------
# For Local Docker / Self-Hosted:
MONGODB_URI=mongodb://admin:EnterpriseSecretPassword2026@localhost:27017/enterprise_ai?authSource=admin
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/enterprise_ai?retryWrites=true&w=majority
MONGODB_DB_NAME=enterprise_ai
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=100
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_CONNECT_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 2. CACHE & SESSION STORE: REDIS
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_DEFAULT_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# 3. VECTOR DATABASE FOR RAG: QDRANT
# ------------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=enterprise_knowledge_base

# ------------------------------------------------------------------------------
# 4. ENTERPRISE CORE BACKEND (JAVA SPRING BOOT)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
JWT_SECRET=4c65637572655f456e74657270726973655f4a57545f53757065725f5365637265745f4b65795f3230323621
JWT_ACCESS_EXPIRATION_MS=3600000        # 1 Hour
JWT_REFRESH_EXPIRATION_MS=604800000     # 7 Days
RATE_LIMIT_CAPACITY=100                 # Max 100 requests per minute
RATE_LIMIT_REFILL_TOKENS=100
RATE_LIMIT_REFILL_DURATION_SECONDS=60

# ------------------------------------------------------------------------------
# 5. AI & MULTI-AGENT SERVICE (PYTHON FASTAPI & LANGGRAPH)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
INTERNAL_SERVICE_API_KEY=enterprise-internal-m2m-token-84920482049284092

# LLM Providers Configuration (Switchable without changing code)
# Options: 'openai', 'anthropic', 'ollama'
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o
OPENAI_MINI_MODEL_NAME=gpt-4o-mini

# Optional Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-3-5-sonnet-20240620

# Optional Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.1

# Embedding Model Configuration
EMBEDDING_PROVIDER=openai               # 'openai', 'huggingface', 'ollama'
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 6. EXTERNAL ENTERPRISE TOOL WEBHOOKS
# ------------------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXXX
JIRA_INSTANCE_URL=https://enterprise.atlassian.net
JIRA_API_TOKEN=
JIRA_USER_EMAIL=
SALESFORCE_INSTANCE_URL=https://enterprise.salesforce.com
SALESFORCE_API_KEY=
SAP_ERP_ENDPOINT=https://erp.enterprise.com/api/v1
SENDGRID_API_KEY=

# ------------------------------------------------------------------------------
# 7. FRONTEND WEB CLIENT (REACT + VITE)
# ------------------------------------------------------------------------------
VITE_CORE_BACKEND_API_URL=http://localhost:8080/api/v1
VITE_AI_SERVICE_STREAM_URL=http://localhost:8000/ai/v1
